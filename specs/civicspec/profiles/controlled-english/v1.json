{
  "profile_id": "civicspec-controlled-english",
  "version": "0.1-draft.1",
  "status": "experimental_frozen_baseline",
  "external_conformance": "STE-inspired; not ASD-STE100 certification",
  "normative_keywords": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "MAY"],
  "authoring": {
    "one_obligation_per_requirement": true,
    "explicit_actor": true,
    "condition_before_action": true,
    "target_words_per_instruction": 20,
    "preserve_source_text": true,
    "ontology_linked_terms": true
  },
  "required_claim_fields": ["id", "actor", "action", "target", "basis", "polarity", "conditions", "quantities", "evidence"],
  "protected_on_rewrite": ["actor", "action", "target", "basis", "polarity", "conditions", "quantities", "evidence"],
  "nonempty_claim_fields": ["id", "actor", "action", "target", "basis", "polarity", "evidence"],
  "classifier_scope": ["minutes_approval", "waive_reading", "debt_authorization", "amendment", "contract_authorization", "contract_award", "reject_bids", "spending_authorization", "appointment", "conditional_appointment", "tabled", "ambiguous", "recommendation", "status_report", "no_responses", "executive_session", "scheduling", "grant_application", "solicitation_authorization", "appointment_amendment", "budget_adoption", "external_request", "schedule_public_hearing", "abstain"],
  "limitations": ["Equality checks preserve an input claim; they do not establish its truth.", "Action recognition uses prelocated excerpts and deterministic patterns; it does not establish a vote outcome.", "No independent model calls or original-audio verification."]
}
