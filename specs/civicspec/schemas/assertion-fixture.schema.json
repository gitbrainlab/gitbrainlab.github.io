{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicspec:schema:assertion-fixture:0.1.0-rc.1",
  "title": "CivicSpec synthetic assertion fixture, not a production contract",
  "description": "Intentionally limited to the public teaching fixture. Exact evidence and semantic fixture expectations require separate checks.",
  "type": "object",
  "properties": {
    "example_only": {
      "const": true
    },
    "schema_status": {
      "const": "illustrative_wire_contract_not_production_schema"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "expected_behavior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "example_only",
    "schema_status",
    "assertions",
    "expected_behavior",
    "note"
  ],
  "additionalProperties": false,
  "$defs": {
    "assertion": {
      "type": "object",
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^urn:example:.+"
        },
        "subject_ref": {
          "type": "string",
          "pattern": "^urn:example:.+"
        },
        "predicate_id": {
          "enum": [
            "vote.yes_count",
            "ext:contract.addendum_approval",
            "ext:statement.polarity"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "count"
                },
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "reported_or_computed": {
                  "enum": [
                    "reported",
                    "computed"
                  ]
                }
              },
              "required": [
                "kind",
                "value",
                "unit",
                "basis",
                "reported_or_computed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "code"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "vocabulary": {
                  "type": "string",
                  "pattern": "^urn:example:.+"
                },
                "vocabulary_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "value",
                "vocabulary",
                "vocabulary_version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "context_refs": {
          "type": "object",
          "properties": {
            "meeting": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "matter": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "treatment": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "vote": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "statement": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "topic": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "meeting"
          ],
          "additionalProperties": false
        },
        "meaning": {
          "type": "object",
          "properties": {
            "basis": {
              "const": "source_reported"
            },
            "attribution": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "polarity": {
              "enum": [
                "affirmative",
                "negative",
                "unknown",
                "contested"
              ]
            },
            "modality": {
              "const": "reported"
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "basis",
            "attribution",
            "polarity",
            "modality",
            "conditions"
          ],
          "additionalProperties": false
        },
        "time": {
          "type": "object",
          "properties": {
            "event_time_assertions": {
              "type": "array",
              "maxItems": 0
            },
            "effective_interval": {
              "type": "null"
            },
            "observed_at": {
              "type": "null"
            },
            "recorded_at": {
              "type": "null"
            }
          },
          "required": [
            "event_time_assertions",
            "effective_interval",
            "observed_at",
            "recorded_at"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "source_version_id": {
                "type": "string",
                "pattern": "^urn:example:.+"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "representation_id": {
                "type": "string",
                "pattern": "^urn:example:.+"
              },
              "representation_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "media_type": {
                "const": "text/plain; charset=utf-8"
              },
              "source_location": {
                "const": "synthetic-source.txt"
              },
              "selector": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "text_range"
                  },
                  "indexing": {
                    "const": "Unicode code points, zero-based, end-exclusive"
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "indexing",
                  "start",
                  "end",
                  "quote"
                ],
                "additionalProperties": false
              },
              "selector_check": {
                "const": "matches_in_fixture"
              }
            },
            "required": [
              "source_version_id",
              "source_sha256",
              "representation_id",
              "representation_sha256",
              "media_type",
              "source_location",
              "selector",
              "selector_check"
            ],
            "additionalProperties": false
          }
        },
        "interpretation": {
          "type": "object",
          "properties": {
            "mapping_profile": {
              "type": "string",
              "minLength": 1
            },
            "extension_status": {
              "enum": [
                "not_applicable",
                "proposed"
              ]
            },
            "extractor": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "null"
            },
            "prompt_version": {
              "type": "null"
            },
            "run_id": {
              "type": "string",
              "pattern": "^urn:example:.+"
            },
            "release_id": {
              "type": "null"
            },
            "release_digest": {
              "type": "null"
            }
          },
          "required": [
            "mapping_profile",
            "extension_status",
            "extractor",
            "model",
            "prompt_version",
            "run_id",
            "release_id",
            "release_digest"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "const": "candidate"
            },
            "review_events": {
              "type": "array",
              "maxItems": 0
            },
            "unresolved_issues": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "review_events",
            "unresolved_issues"
          ],
          "additionalProperties": false
        },
        "lineage": {
          "type": "object",
          "properties": {
            "supports": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:example:.+"
              }
            },
            "contradicts": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:example:.+"
              }
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:example:.+"
              }
            },
            "derived_from": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^urn:example:.+"
              }
            }
          },
          "required": [
            "supports",
            "contradicts",
            "supersedes",
            "derived_from"
          ],
          "additionalProperties": false
        },
        "publication": {
          "type": "object",
          "properties": {
            "access_class": {
              "const": "public_synthetic_example"
            },
            "eligible_for_civic_fact_view": {
              "const": false
            }
          },
          "required": [
            "access_class",
            "eligible_for_civic_fact_view"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "assertion_id",
        "subject_ref",
        "predicate_id",
        "value",
        "context_refs",
        "meaning",
        "time",
        "evidence",
        "interpretation",
        "review",
        "lineage",
        "publication"
      ],
      "additionalProperties": false
    }
  }
}
